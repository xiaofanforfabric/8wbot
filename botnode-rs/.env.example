# 8W 邦国崛起机器人节点 —— 配置示例
#
# 复制成 .env 放在二进制旁边（或它的上一级），然后改掉密钥。
#
#   cp .env.example .env
#   chmod 600 .env          # 里面有密钥
#
# 这些变量也可以直接给进程环境变量，那边优先级更高 —— 适合 systemd 的
# Environment= 或容器编排。

# ── 必填 ─────────────────────────────────────────────────────────

# 与香港 Go 后端共享的密钥。两边必须完全一致。
#
# 不填的话节点照常运行，但任何能连上控制端口的人都能启停你的机器人、
# 代替它们说话。绑在 127.0.0.1 上降低了风险，但反代通常会把公网流量
# 引过来，所以这个必须填。
INTERNAL_NODE_SECRET=改成和香港那边一样的值

# ── 游戏服务器 ───────────────────────────────────────────────────

MC_HOST=bgjq.simpfun.cn
MC_PORT=25565

# 想一次给全 host:port 时用这个，它会盖掉上面两个。
# MC_ADDRESS=bgjq.simpfun.cn:25565

# ── 控制端口 ─────────────────────────────────────────────────────

# 默认 8088。原来 JS 节点用的是 8889 —— 如果 E5 上的反向代理规则已经指向
# 8889，这里保持 8889 就不用改反代。
WS_PORT=8088

# 想换绑定地址时用这个，它会盖掉 WS_PORT。
# 默认只绑 127.0.0.1。改成 0.0.0.0 会让控制端口直接暴露在公网，
# 那意味着密钥是唯一的防线 —— 不建议。
# CONTROL_ADDR=127.0.0.1:8889

# ── 日志 ─────────────────────────────────────────────────────────

# 排查问题时把它设成 debug。
# 放在 .env 里也生效 —— 节点会把它转交给日志系统。
RUST_LOG=info,azalea=warn,bevy=warn
