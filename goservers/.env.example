# ========================================================
# 8wbot Go 控制中心服务端配置模板
# 用法: cp .env.example .env  然后填入真实值
# ========================================================

# HTTP 监听端口 (默认 :8888)
PORT=:8888

# Cap 人机验证系统配置 (必填)
CAP_SITE_KEY=YOUR_CAP_SITE_KEY
CAP_SECRET_KEY=YOUR_CAP_SECRET_KEY
CAP_SERVER_URL=https://cap.fanverify.cn

# 开放平台鉴权配置 (必填)
DEV_UUID=YOUR_DEV_UUID
FANVERIFY_API_BASE=https://api.fanverify.cn
FANVERIFY_ACCESS_TOKEN=YOUR_ACCESS_TOKEN

# 管理员 SSH 终端密码
SSH_PASSWORD=CHANGE_ME

# ========================================================
# 跨域 (CORS) 配置
# ========================================================
# 前端与 API 不同域时必须正确配置，否则浏览器会拦截请求。
# 支持逗号分隔的混合写法：
#   *                       放行所有来源（API 使用 Bearer Token 鉴权，不依赖跨域 Cookie）
#   https://a.example.com   精确匹配来源
#   *.example.com           匹配该域名及其所有子域（含 ESA Pages 预览域名）
#
# 生产环境推荐收敛为白名单，例如：
#   CORS_ALLOWED_ORIGINS=https://bgjq.xiaofanai.uk,https://8w.bgjq.top
CORS_ALLOWED_ORIGINS=*

# ========================================================
# 内部节点跨机通信安全配置 (Go 控制中心 -> JS 假人节点)
# ========================================================
# 内部通讯令牌，必须与 JS 端 .env 的 INTERNAL_NODE_SECRET 完全一致
INTERNAL_NODE_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# JS 节点的 WebSocket 地址（公网域名 / IP / 内网穿透地址）
JS_NODE_URL=ws://js.xiaofanai.uk:8889
