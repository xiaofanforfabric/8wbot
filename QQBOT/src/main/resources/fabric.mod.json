{
  "schemaVersion": 1,
  "id": "qqbot",
  "version": "${version}",
  "name": "QQBOT",
  "description": "",
  "authors": [],
  "contact": {},
  "license": "unlicense",
  "icon": "assets/qqbot/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "com.xiaofan.qqbot.client.QqbotDataGenerator"
    ],
    "client": [
      "com.xiaofan.qqbot.client.QqbotClient"
    ],
    "main": [
      "com.xiaofan.qqbot.Qqbot"
    ]
  },
  "mixins": [
    "qqbot.mixins.json",
