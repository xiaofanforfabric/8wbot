# ==============================================================================
#  BGJQ 工作区忽略规则
#  基于对 /mnt/ai/BGJQ 全目录的敏感文件扫描结果生成
#
#  重要提示：
#    bgjq-web/ 与 8wbot/ 是各自独立的 git 仓库（各有自己的 .gitignore），
#    本文件只对「以 BGJQ 为根仓库」的场景生效，不会覆盖那两个子仓库的规则。
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. 密钥与凭据文件  ★最高优先级★
# ------------------------------------------------------------------------------
# 实测含真实密钥的文件（严禁提交）：
#   8wbot/goservers/.env            -> CAP_SITE_KEY / CAP_SECRET_KEY
#                                      SSH_PASSWORD / INTERNAL_NODE_SECRET
#   8wbot/8wbotforJavaScript/.env   -> INTERNAL_NODE_SECRET / SSH_HOST_KEY_B64
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!.env.template
.env.local
.env.*.local
*.local

# JWT 签名密钥 / SSH 主机私钥（实测存在，内容为 RSA PRIVATE KEY）
jwt.secret
*.secret
**/jwt.secret
ssh_host_key
**/ssh_host_key

# 通用私钥与证书
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*

# 各类凭据缓存
.git-credentials
.netrc
_netrc
.npmrc
.pypirc
credentials.json
service-account*.json


# ------------------------------------------------------------------------------
# 2. 数据库文件
# ------------------------------------------------------------------------------
# 实测存在：8wbot/goservers/data.sqlite
#          8wbot/goservers/data.sqlite.backup_before_fanverify
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.db-journal
*.db-wal
*.db-shm
*backup_before_*
*.dump


# ------------------------------------------------------------------------------
# 3. 日志文件（可能含玩家ID / IP / 聊天内容）
# ------------------------------------------------------------------------------
# 实测存在：8wbot/goservers/botlogs/wans7891.log
# ------------------------------------------------------------------------------
*.log
**/*.log
logs/
botlogs/
**/botlogs/


# ------------------------------------------------------------------------------
# 4. 批量数据导出（含全服玩家/邦国信息，属敏感数据集）
# ------------------------------------------------------------------------------
# 实测：data/ 下有 players.json(800KB)、u554_terr.json、logs_all.json 等全量抓取结果
# 如果这些数据你确实想纳入版本管理，把下面这行注释掉即可
# ------------------------------------------------------------------------------
data/


# ------------------------------------------------------------------------------
# 5. 依赖与构建产物
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/

# 前端 / 通用构建输出
dist/
dist-ssr/
build/
**/build/
out/
target/
.next/
.cache/

# Gradle
.gradle/
**/.gradle/
!gradle/wrapper/gradle-wrapper.jar

# 编译产物
*.exe
*.dll
*.so
*.dylib
*.o
*.a
*.class
*.jar
*.war
*.apk

# Go 编译出的无扩展名可执行文件
# 实测存在：8wbot/goservers/goservers、8wbot/goservers/8wbot-server
# 注意：带路径的规则会被锚定到根目录，必须加 **/ 前缀才能在任意深度匹配；
#       同时不能用裸 `goservers`，否则会把 goservers/ 源码目录整个忽略掉。
8wbot-server
**/goservers/goservers


# ------------------------------------------------------------------------------
# 6. 工具链缓存目录（实测存在于 BGJQ 根目录）
# ------------------------------------------------------------------------------
.gocache/
.golang/
.gotest/
.gotmp/
.npm-cache/


# ------------------------------------------------------------------------------
# 7. IDE / 编辑器配置（可能含本地绝对路径与历史记录）
# ------------------------------------------------------------------------------
.idea/
**/.idea/
!.idea/runConfigurations/
.vscode/
**/.vscode/
!.vscode/extensions.json
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln


# ------------------------------------------------------------------------------
# 8. 操作系统临时文件
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/


# ------------------------------------------------------------------------------
# 9. 临时 / 备份文件
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.old
*.orig
*.swp
*.swo
*~
*.backup_simpfun
*.backup_before_*


# ------------------------------------------------------------------------------
# 10. 压缩包（实测 8wbot/8wbotforJavaScript.zip 达 34.76MB，不入库）
# ------------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar


# ------------------------------------------------------------------------------
# 11. 本地备份 / 工具 / 暂存目录（不纳入版本管理）
# ------------------------------------------------------------------------------
.backups/
.tools/
.verify/
.rewrite-hold/
.ignoretest/
.bgjq-push/

